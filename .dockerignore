# Todo lo que no necesita la imagen. Cuanto menos entre, mas rapido el build
# y menos superficie tiene la imagen final.

.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore

# Evidencia y resultados: se generan en tu maquina, no dentro del contenedor.
evidencia/
resultados/
docs/

# Los datos crudos NO entran: el modelo ya esta entrenado dentro del store de
# MLflow que se copia. El contenedor solo sirve predicciones; no reentrena.
data/

# Manifiestos, interfaz y scripts: se ejecutan desde fuera del contenedor.
k8s/
ui/
scripts/

# Documentacion
*.md
